{
  "schemaVersion": 1,
  "id": "adaptive_performance_tweaks",
  "version": "${version}",
  "name": "Adaptive Performance Tweaks",
  "description": "Single-bundle server-performance mod: dynamic spawn limits, sim-distance, AI throttling, chunk-gen throttle, AFK optimizations. Server-required, client-optional.",
  "authors": [
    "Markus Bordihn"
  ],
  "contact": {
    "homepage": "https://curseforge.com/minecraft/mc-mods/adaptive-performance-tweaks",
    "issues": "https://github.com/MarkusBordihn/BOs-Adaptive-Performance-Tweaks/issues"
  },
  "license": "MIT",
  "icon": "logo.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "de.markusbordihn.adaptiveperformancetweaks.AdaptivePerformanceTweaks"
    ],
    "client": [
      "de.markusbordihn.adaptiveperformancetweaks.AdaptivePerformanceTweaksClient"
    ],
    "fabric-gametest": [
      "de.markusbordihn.adaptiveperformancetweaks.gametest.SmokeTest",
      "de.markusbordihn.adaptiveperformancetweaks.gametest.FeatureToggleGameTest",
      "de.markusbordihn.adaptiveperformancetweaks.gametest.MixinGameTest",
      "de.markusbordihn.adaptiveperformancetweaks.gametest.GameRuleAdaptationGameTest",
      "de.markusbordihn.adaptiveperformancetweaks.gametest.SpawnPresetConfigGameTest",
      "de.markusbordihn.adaptiveperformancetweaks.gametest.SpawnThrottleGameTest",
      "de.markusbordihn.adaptiveperformancetweaks.gametest.AiThrottleGameTest",
      "de.markusbordihn.adaptiveperformancetweaks.gametest.DistanceAdaptationGameTest",
      "de.markusbordihn.adaptiveperformancetweaks.gametest.ItemOptimizationGameTest",
      "de.markusbordihn.adaptiveperformancetweaks.gametest.PlayerLoginProtectionGameTest",
      "de.markusbordihn.adaptiveperformancetweaks.gametest.PlayerDamageGameTest",
      "de.markusbordihn.adaptiveperformancetweaks.gametest.EntityFilterGameTest",
      "de.markusbordihn.adaptiveperformancetweaks.gametest.ChunkGenThrottleGameTest",
      "de.markusbordihn.adaptiveperformancetweaks.gametest.MonitoringGameTest"
    ]
  },
  "mixins": [
    "adaptiveperformancetweaks.mixins.json"
  ],
  "accessWidener": "adaptiveperformancetweaks.accesswidener",
  "depends": {
    "fabricloader": ">=0.16",
    "fabric": "*",
    "minecraft": ">=1.21.1 <1.22",
    "java": ">=21"
  }
}
