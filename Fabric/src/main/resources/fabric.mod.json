{
  "schemaVersion": 1,
  "id": "adaptive_performance_tweaks",
  "version": "${version}",
  "name": "Adaptive Performance Tweaks",
  "description": "Server-side optimization mod that adapts load with dynamic spawn limits, simulation distance, AI throttling, chunk generation throttling, and monitoring tools for dedicated servers, single-player worlds, and LAN worlds.",
  "authors": [
    "Markus Bordihn"
  ],
  "contact": {
    "homepage": "https://curseforge.com/minecraft/mc-mods/adaptive-performance-tweaks",
    "issues": "https://github.com/MarkusBordihn/BOs-Adaptive-Performance-Tweaks/issues"
  },
  "license": "MIT",
  "icon": "logo.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "de.markusbordihn.adaptiveperformancetweaks.AdaptivePerformanceTweaks"
    ],
    "client": [
      "de.markusbordihn.adaptiveperformancetweaks.AdaptivePerformanceTweaksClient"
    ]
  },
  "mixins": [
    "adaptiveperformancetweaks.mixins.json"
  ],
  "accessWidener": "adaptiveperformancetweaks.accesswidener",
  "depends": {
    "fabricloader": "${fabric_loader_version_range}",
    "fabric-api": "*",
    "minecraft": "${fabric_minecraft_version_range}",
    "java": "${java_version_range}"
  }
}
